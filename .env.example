# Copy to .env.local and fill in. All values are optional — the site
# falls back to the sample content in src/content.ts when they're missing.

# Public Google Calendar (Calendar settings → "Make available to public").
# The ID looks like abc123@group.calendar.google.com
VITE_GOOGLE_CALENDAR_ID=
# Browser API key with the Google Calendar API enabled.
# Restrict it to your site's domain in Google Cloud Console.
VITE_GOOGLE_API_KEY=

# Public Google Sheet (Share → "Anyone with the link can view").
# The ID is the long string in the sheet URL: /spreadsheets/d/<ID>/edit
VITE_GOOGLE_SHEET_ID=
